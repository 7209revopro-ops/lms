# Copy to .env.local for `npx expo start`. Only EXPO_PUBLIC_* reaches the app,
# and everything here is PUBLIC — it is compiled into the bundle. No secrets.

# The backend's /api/v1. On a real phone use this computer's LAN address
# (e.g. http://192.168.1.20:8000/api/v1); 10.0.2.2 is the Android emulator's
# name for this computer; localhost only works in the iOS simulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Crash reporting (optional). Empty → Sentry is not started.
EXPO_PUBLIC_SENTRY_DSN=

# The student website (privacy policy, terms). Defaults to production.
EXPO_PUBLIC_SITE_URL=https://lms.deltainstitutions.com
