{
  "expo": {
    "name": "Delta Institutions",
    "slug": "delta-lms",
    "scheme": "deltalms",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.deltainstitutions.lms",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:lms.deltainstitutions.com"
      ]
    },
    "android": {
      "package": "com.deltainstitutions.lms",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "lms.deltainstitutions.com",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "lms.deltainstitutions.com",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "lms.deltainstitutions.com",
              "pathPrefix": "/messages"
            },
            {
              "scheme": "https",
              "host": "lms.deltainstitutions.com",
              "pathPrefix": "/class-bookings"
            },
            {
              "scheme": "https",
              "host": "lms.deltainstitutions.com",
              "pathPrefix": "/my-bookings"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#122B4F",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#0057b8"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Delta Institutions uses your photos to add a profile photo and copies of your passport or ID when you register.",
          "cameraPermission": "Delta Institutions uses the camera to take your profile photo and photos of your passport or ID when you register.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
