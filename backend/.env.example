# ────────────────────────────────────────────────
# Server
# ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ────────────────────────────────────────────────
# Database — MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/lms
# Atlas:  mongodb+srv://USER:PASS@cluster.xxx.mongodb.net/lms
# ────────────────────────────────────────────────
DATABASE_URL=mongodb://127.0.0.1:27017/lms

# ────────────────────────────────────────────────
# JWT — must be 32+ char random strings
# Generate: openssl rand -base64 48
# ────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-32+-char-random-secret-string
JWT_REFRESH_SECRET=replace-with-different-32+-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ────────────────────────────────────────────────
# CORS — allowed frontend origins
# ────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ────────────────────────────────────────────────
# Bcrypt cost factor (10–14, higher = slower hash)
# ────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ────────────────────────────────────────────────
# Email (Nodemailer SMTP)
# Leave all blank → emails are captured to .logs/emails/*.html for dev preview.
# Set all four to use a real provider.
#
# Gmail (with an App Password, NOT your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=<16-char app password>
#   EMAIL_FROM="LearnOS <youraddress@gmail.com>"
#
# Brevo (sendinblue):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<your-key>
# Mailgun:  SMTP_HOST=smtp.mailgun.org
# AWS SES:  SMTP_HOST=email-smtp.<region>.amazonaws.com
#
# SMTP_SECURE: leave blank to auto-pick (true for port 465, false otherwise).
# Override only if your provider needs it.
# ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=

# ────────────────────────────────────────────────
# Stripe — payments (5.1–5.5)
# Get keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... in development, sk_live_... in production.
#
# STRIPE_WEBHOOK_SECRET:
#   Development: run `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`
#                and copy the whsec_... it prints.
#   Production:  create a webhook endpoint in the Stripe dashboard pointing at
#                https://your-domain.com/api/v1/webhooks/stripe, then copy the
#                signing secret.
# ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret
STRIPE_CURRENCY=usd

# ────────────────────────────────────────────────
# Razorpay — INR payments (alternative to Stripe)
# Get keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) in development.
#
# RAZORPAY_WEBHOOK_SECRET:
#   Dashboard → Settings → Webhooks → Add New Webhook
#   Point to https://your-domain.com/api/v1/webhooks/razorpay
#   → copy the secret you set there.
#
# Leave blank to disable Razorpay checkout entirely.
# ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# ────────────────────────────────────────────────
# UAE / GCC gateways — AED checkout
# Shown only to students whose enrollmentApplication.homeCountry is a
# Middle-East country; Tabby and Tamara are UAE-only. Any gateway whose
# key is blank is hidden from the cart, so blank == disabled.
# ────────────────────────────────────────────────

# Abzer / BillXPro — card checkout (all Middle East)
# Sandbox: https://sandbox.billxpro.com/as/api/v100
# Live:    https://billxpro.com/as/api/v100
ABZER_ACCESS_KEY=
ABZER_SECRET_KEY=
ABZER_BASE_URL=https://sandbox.billxpro.com/as/api/v100
ABZER_CURRENCY=AED
ABZER_TEMPLATE_CODE=paymentlink-mail-template
ABZER_WEBHOOK_SECRET=

# Tamara — BNPL "Pay in 3" (UAE only)
# Portal: https://partners.tamara.co → Settings → API
# Webhook is registered MANUALLY in the portal, pointing at
#   <BACKEND_PUBLIC_URL>/api/v1/webhooks/tamara
# Sandbox: https://api-sandbox.tamara.co   Live: https://api.tamara.co
TAMARA_API_KEY=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_BASE_URL=https://api-sandbox.tamara.co
TAMARA_CURRENCY=AED

# Tabby — BNPL "Pay in 4" (UAE only)
# Portal: https://merchant.tabby.ai → Developer / API keys
# The webhook registers itself at boot; TABBY_WEBHOOK_SECRET is a value
# YOU choose and Tabby echoes back as an Authorization bearer header.
# Tabby infers test vs live from the key itself: sk_test_... vs sk_... (prod).
# TABBY_PUBLIC_KEY is unused today (on-site promo widget not implemented).
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=
TABBY_CURRENCY=AED

# Fallback USD→AED / USD→INR rates, used when a course has no explicit
# priceAED / priceINR override set by an admin.
UAE_EXCHANGE_RATE=3.67
INR_EXCHANGE_RATE=83

# ────────────────────────────────────────────────
# Public URL — used by upload routes to build file URLs
# Must be reachable by the browser.
# In development: http://localhost:4000 (or your ngrok tunnel URL)
# ────────────────────────────────────────────────
BACKEND_PUBLIC_URL=http://localhost:4000

# ────────────────────────────────────────────────
# Cloudflare R2 — media file uploads (OPTIONAL)
# Leave blank to disable file upload endpoints.
# Bucket must be public or use a presigned-URL flow.
# ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=learnos-media
R2_PUBLIC_URL=

# ────────────────────────────────────────────────
# Mux — live streaming (OPTIONAL)
# Leave blank to disable live-class streaming.
# Get keys from https://dashboard.mux.com
# ────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ────────────────────────────────────────────────
# Google Meet — auto-generated links for external live sessions
#
# Uses OAuth2 (personal Gmail or Google Workspace account).
#
# One-time setup:
#   1. console.cloud.google.com → enable "Google Calendar API"
#   2. APIs & Services → Credentials → your OAuth 2.0 Client ID
#      → copy Client ID  → GOOGLE_CLIENT_ID
#      → copy Client secret → GOOGLE_CLIENT_SECRET
#   3. Get a refresh token (run once in a browser, sign in with your Google account):
#      https://accounts.google.com/o/oauth2/auth
#        ?client_id=<YOUR_CLIENT_ID>
#        &redirect_uri=urn:ietf:wg:oauth:2.0:oob
#        &response_type=code
#        &scope=https://www.googleapis.com/auth/calendar.events
#        &access_type=offline&prompt=consent
#      Exchange the auth code via POST to https://oauth2.googleapis.com/token
#      and copy the returned refresh_token → GOOGLE_REFRESH_TOKEN
#   4. GOOGLE_CALENDAR_ID: use "primary" for the signed-in account's main calendar,
#      or paste the calendar ID from Google Calendar → Settings → Integrate calendar.
#
# Leave blank → creating an external session returns 503 with a clear message.
# ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ────────────────────────────────────────────────
# AI — Ollama (local LLM for transcript generation)
# Install: https://ollama.com/download
# Pull model: ollama pull llama3.2:3b
# ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Per-visitor rate limiting (M-11) ─────────────────────────────────
# Browsers reach the API through the Next proxy, so the backend sees the
# proxy's address for everyone and one rate-limit bucket ends up shared by
# the whole user base. Set the SAME value here, in client/.env and in
# admin/.env so the proxies can relay the real visitor address and prove it
# came from them. Generate one with:  openssl rand -hex 32
# Leave unset to keep the old shared-bucket behaviour.
PROXY_SHARED_SECRET=

# ── Identity-document storage (H-11) ─────────────────────────────────
# Passport and national-ID scans must NOT live in the public media bucket:
# R2_PUBLIC_URL is a pub-*.r2.dev host, which exposes the whole bucket.
# Create a SECOND R2 bucket with public access DISABLED and name it here.
# Reads are then signed and expire after 5 minutes.
# Leave unset and the scans stay publicly readable — the server warns on boot.
R2_KYC_BUCKET_NAME=

# ── Session token lifetime (M-02) ────────────────────────────────────
# Access tokens carry no server-side state, so nothing can revoke one before
# it expires: logout, a password change and account deletion all leave an
# issued token working until its TTL runs out. Keep this SHORT.
#
# Staged rollout — do not jump straight to 15m on a live system:
#   7d  →  1h  →  15m,  watching POST /auth/refresh volume and TOKEN_EXPIRED
#   rates between steps. Requires per-visitor rate limiting (M-11) to be on,
#   or the extra refresh traffic exhausts the shared login limit.
#   (declared near the top of this file)
#
# Impersonation is a bare Bearer token with NO refresh counterpart, so it does
# not follow the session TTL — it would otherwise strand an admin mid-task.
IMPERSONATION_EXPIRES_IN=30m

# ═══════════════════════════════════════════════════════════════════════
# MEETING PLATFORM (Delta Connect / CLT) — the LMS half of the join flow
# ═══════════════════════════════════════════════════════════════════════
# A student clicks Join in the client, or an instructor clicks Join in the
# admin panel, and the browser is REDIRECTED to the meeting application
# carrying a one-time code. The meeting server exchanges that code with us
# over a signed server-to-server call and receives an Ed25519 ticket naming
# the person and what they may do. Nothing bearer-shaped is ever in a URL,
# and the meeting app never asks anyone who they are.
#
# THE WHOLE INTEGRATION IS OPTIONAL. Leave INTEGRATION_JWT_PRIVATE_KEY blank
# and the LMS behaves exactly as it did before: the Join button reports that
# the integration is not configured, and nothing else changes.
#
# NONE OF THESE ARE VALIDATED AT BOOT. A typo produces a server that starts
# healthy and fails only when somebody clicks Join. After any change here,
# do the smoke test in plan.md §8.6 — it is the only thing that will tell you.

# ── Signing: the LMS holds the private key, the meeting app only verifies ──
# Ed25519, PKCS#8, BASE64-ENCODED — not raw PEM. A PEM is multi-line and .env
# is line-based; Bun ends the value at the first newline and OpenSSL then
# rejects it with a misleading BAD_END_LINE. Generate with:
#
#   openssl genpkey -algorithm ed25519 -out lms-prod.pem
#   base64 -w0 lms-prod.pem          # macOS: base64 -i lms-prod.pem
#
# GENERATE A FRESH KEY FOR PRODUCTION. Never promote a key that has sat in a
# developer's working tree.
INTEGRATION_JWT_PRIVATE_KEY=
# Names this key in the JWKS so the meeting app knows which one to verify
# with. Any stable string; date-stamping makes rotation self-documenting.
INTEGRATION_JWT_KID=lms-2026-01

# ── Rotation: publish the new key, wait one meeting-side cache TTL (1h),
#    then drop the old one. Both verify during the overlap, no coordinated
#    deploy. Blank outside a rotation. ──
INTEGRATION_JWT_PRIVATE_KEY_PREVIOUS=
INTEGRATION_JWT_KID_PREVIOUS=

# ── Ticket claims. Must match the meeting app's LMS_JWT_ISSUER / _AUDIENCE
#    exactly, or every join fails verification. ──
INTEGRATION_JWT_ISSUER=lms.deltainstitutions
INTEGRATION_JWT_AUDIENCE=clt-connect
# Seconds. The ticket is spent the instant it arrives, so this covers one
# redirect, not a class. Short is correct.
INTEGRATION_TICKET_TTL_SEC=90

# ── Where the meeting platform lives ──
# CLT_BASE_URL is the meeting API, server-to-server. The LMS calls it to
# provision rooms. Never sent to a browser.
CLT_BASE_URL=https://meet-api.example.com
# CLT_PUBLIC_URL is the meeting SPA, the origin the STUDENT'S BROWSER is
# redirected to. These are the same value only if the SPA and its API are
# served from one origin — confirm against the real deployment, because a
# wrong value here redirects people to a page that cannot exchange the code.
CLT_PUBLIC_URL=https://meet.example.com
# Shared HMAC secret for the S2S channel, both directions. Must equal the
# meeting app's LMS_S2S_SECRET byte for byte. 32+ random bytes:
#   openssl rand -hex 32
CLT_S2S_SECRET=
CLT_TIMEOUT_MS=8000

# Per-room seat cap the LMS asks for when it provisions a room. NOTE: the
# integration doc calls this LIVEKIT_MAX_SEATS; that name is read by nothing.
LIVEKIT_MAX_PARTICIPANTS=50

# ── What a person is called on their tile ──
# Unset (the default) = their EMAIL ADDRESS, for both students and
# instructors. Emails are unique and are what attendance and support
# reconcile against; display names are neither unique nor verified.
#
# THE COST, STATED ON PURPOSE: LiveKit broadcasts this to everyone in the
# room, so every student can read the instructor's address and each other's.
# Set MEETING_DISPLAY_NAME=name to show LMS profile names instead, falling
# back to the email for an account that has none. Read once at startup — a
# change needs a restart.
MEETING_DISPLAY_NAME=

# ── Delta Finance → LMS: enrolments approved in accounts ──
#
# When an approver in Delta Finance signs off an enrolment the sales CRM
# raised, finance calls this server to create the student, enrol and approve
# them on the mapped course, and email a one-click login link.
#
# A shared secret, compared in constant time, presented as X-Finance-Secret.
# It must be the same string as LMS_S2S_SECRET on the finance side.
#
# Unset, the endpoint answers 503 and the integration is simply off: finance
# approves invoices exactly as it did before and provisions nobody. That is the
# intended state for an installation not using it.
#
# Which course a student lands on is decided in finance, by mapping the item to
# a course SLUG here — never by the course's name. Finance holds several
# spellings of the same course, and enrolling somebody on the wrong one is
# worse than not enrolling them, so an unmapped item provisions nobody and
# says so instead of guessing.
FINANCE_S2S_SECRET=
