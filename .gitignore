# ─── Dependencies ────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Environment / Secrets ───────────────────────────
.env
.env.*
!.env.example

# ─── Build outputs ───────────────────────────────────
.next/
out/
dist/
build/

# ─── TypeScript ──────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Logs ────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.logs/

# ─── Testing / Coverage ──────────────────────────────
coverage/
.nyc_output/

# ─── OS / Editor ─────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*.swo

# ─── Vercel / Deployment ─────────────────────────────
.vercel

# ─── Lock files (keep one, ignore the rest) ──────────
package-lock.json
yarn.lock
bun.lockb

# ─── Claude Code ─────────────────────────────────────
.claude/worktrees/

# ─── Uploads / Media (local dev only) ────────────────
uploads/
public/uploads/

# Stale editor/backup artefacts
*.tmp
*.bak
*.orig

# Gateway credential drops. These arrive as raw token files from the provider
# and are NOT config — the real values belong in backend/.env. Ignored so a
# `git add .` can never publish a live merchant token.
docs/API_TOKEN_*.txt
docs/*credentials*

# Internal ops notes — infrastructure detail, keep out of the repo
SERVER.md
